APP_NAME=Lindr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration (PostgreSQL / Supabase)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lindr
DB_USERNAME=postgres
DB_PASSWORD=secret

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis Configuration (For VPS Phase 2 / queues)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum Authentication
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Storage (Supabase / S3 compatible)
FILESYSTEM_DISK=public
SUPABASE_URL=
SUPABASE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# M-Pesa Payment Integration (Safaricom Daraja)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/mpesa

# KoraPay Payment Gateway
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=
KORAPAY_MODE=test

# Flutterwave Payment Gateway
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_MODE=test

# Google Pay Configuration
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_ID=12345678901234567890
GOOGLE_PAY_MERCHANT_NAME="Lindr Dating"
GOOGLE_PAY_PROCESSOR=flutterwave

# LiveKit (Phase 2 Audio/Video Preparation)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@lindr.app"
MAIL_FROM_NAME="${APP_NAME}"
